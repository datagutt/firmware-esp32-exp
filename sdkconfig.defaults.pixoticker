CONFIG_BOARD_PIXOTICKER=y
CONFIG_SWAP_COLORS=y
CONFIG_HTTP_BUFFER_SIZE_MAX=60000
CONFIG_HTTP_BUFFER_SIZE_DEFAULT=10000
CONFIG_BOOT_WEBP_PARROT=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/max_app_4mb.csv"
CONFIG_HUB75_CLK_PHASE_INVERTED=y

# No PSRAM, so every TLS buffer lives in internal RAM. Allocate the TLS
# record buffers only while data is in flight and drop the CA/key data once
# the handshake is done, instead of pinning ~20 KB per session.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# Static WiFi TX buffers are only needed to guarantee buffers when PSRAM is
# in use. Without it, dynamic buffers free ~13 KB of internal RAM when idle.
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y

# The ESP32 I2S output clock is 160 MHz / (div * 4), so 16 MHz rounds to
# 13.33 MHz. Paired with a 120 Hz minimum refresh rate this is the panel
# timing these boards have always shipped with.
# CONFIG_HUB75_CLK_8MHZ is not set
CONFIG_HUB75_CLK_16MHZ=y
CONFIG_HUB75_MIN_REFRESH_RATE=120
